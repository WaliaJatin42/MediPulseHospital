{
  "info": {
    "_postman_id": "a983b271-89d2-4e4b-9e12-8827ab102941",
    "name": "MediPulse Hospital API",
    "description": "Postman Collection for MediPulse Hospital API (v1).\nFeatures 8 Departments (HR, Pharmacy, Technical, Security, Support, Legal, Accounts), HR Admin & HR Supervisor Cross-Department Hiring, Reset Password API, and 9-Hour Work Policy Punch-In/Punch-Out Attendance System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Check Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Verify system status and database connectivity."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (SuperAdmin / HR Admin / Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response.success && response.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', response.accessToken);",
                  "    console.log('AccessToken automatically saved to collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@hospital.com\",\n  \"password\": \"SuperAdmin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticate user with email and password."
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Attendance System (9-Hour Policy)",
      "item": [
        {
          "name": "Punch In (Start 9-Hour Shift)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workMode\": \"on_site\",\n  \"notes\": \"Morning shift arrival\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/punch-in",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "punch-in"]
            },
            "description": "Clock in to start a 9-hour work shift."
          }
        },
        {
          "name": "Punch Out (Complete Shift)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/punch-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "punch-out"]
            },
            "description": "Clock out. Calculates total work hours against the 9-hour work policy."
          }
        },
        {
          "name": "Get My Personal Attendance Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "me"]
            }
          }
        },
        {
          "name": "Get All Staff Attendance (Superadmin, HR Admin, HR Supervisor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance?department=&status=&date=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance"],
              "query": [
                { "key": "department", "value": "", "description": "Filter by department (hr, pharmacy, technical, security, etc.)" },
                { "key": "status", "value": "", "description": "Filter by status (present, late, half_day, short_hours)" },
                { "key": "date", "value": "", "description": "Filter by YYYY-MM-DD" }
              ]
            },
            "description": "Visible to Superadmin, HR Admin, and HR Supervisors across all departments."
          }
        },
        {
          "name": "Manual Attendance Entry (Admin / HR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"date\": \"2026-10-08\",\n  \"status\": \"present\",\n  \"notes\": \"Manual entry by HR Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/manual",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attendance", "manual"]
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Logged-in User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "User Management (HR & Dept Admins)",
      "item": [
        {
          "name": "Create User / Hire Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response.success && response.user && response.user._id) {",
                  "    pm.collectionVariables.set('userId', response.user._id);",
                  "    console.log('Created userId saved to collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Chang\",\n  \"email\": \"pharmacist.new@hospital.com\",\n  \"password\": \"User123!\",\n  \"role\": \"user\",\n  \"designation\": \"Pharmacist\",\n  \"department\": \"pharmacy\",\n  \"phone\": \"+1 (555) 000-0999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "HR Admin & HR Supervisor can create supervisors/users for ANY department. Dept Admins create for their department."
          }
        },
        {
          "name": "List Users (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?department=&search=&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "department", "value": "" },
                { "key": "search", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Reset User Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "reset-password"]
            },
            "description": "SuperAdmin can reset any user's password. HR Admin can reset cross-department staff passwords. Dept Admin resets their department staff or self."
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Chang\",\n  \"designation\": \"Senior Pharmacist\",\n  \"phone\": \"+1 (555) 000-0888\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        }
      ]
    }
  ]
